autoload=no
autostart=no
bootcmd=
#if defined(CONFIG_AHAB_BOOT)
	ahab_status;
#endif
#if defined(CONFIG_IMX_HAB)
	hab_status;
#endif
	run loadregdomain;
	run loadimage;
	bootm start ${loadaddr}${conf} || bootm start ${loadaddr};
	bootm loados;
#if defined(CONFIG_CMD_REMOTEPROC)
		if test "${mcu_firmware_available}" = 1; then
#if defined(CONFIG_IMX8MM)
			setenv bootargs "${bootargs} clk-imx8mm.mcore_booted";
#elif defined(CONFIG_IMX8MN)
			setenv bootargs "${bootargs} clk-imx8mn.mcore_booted";
#elif defined(CONFIG_IMX8MP)
			setenv bootargs "${bootargs} clk-imx8mp.mcore_booted";
#elif defined(CONFIG_IMX8MQ)
			setenv bootargs "${bootargs} clk-imx8mq.mcore_booted";
#elif defined(CONFIG_IMX93)
			setenv bootargs "${bootargs} clk-imx93.mcore_booted";
#endif
			rproc init &&
			for mcu_core in ${mcu_firmware_cores}; do
				rproc load ${mcu_core} ${mcu_firmware_addr_${mcu_core}} \
					${mcu_firmware_size_${mcu_core}} &&
				rproc start ${mcu_core};
			done;
		fi;
#endif
	bootm ramdisk;
	bootm prep;
	bootm go;
	reset
bootside=a
cdc_connect_timeout=15
env_fdt_path=/config/environment
#if defined(CONFIG_CMD_DFU) && defined(CONFIG_DFU_RAM)
bootargs=root=/dev/ram0 bootside=${bootside}
dfu_alt_info=kernel ram ${loadaddr}
loadimage=dfu 0 ram 0
#elif defined(CONFIG_CMD_FASTBOOT)
bootargs=root=/dev/ram0 bootside=${bootside}
loadimage=fastboot -l ${loadaddr} 0
#elif defined(CONFIG_CMD_SDP)
bootargs=root=/dev/ram0 bootside=${bootside}
loadimage=sdp 0
#else
loadimage=
	test -z "${choose_boot}" || run choose_boot;
	if test ${bootside} = b; then
		setenv bootvol 4;
	else
		setenv bootvol 1;
		setenv bootside a;
	fi;
	if test ${boot_src} = sd; then
		setenv rootvol 5;
	else
		setexpr rootvol ${bootvol} + 1;
	fi;
	if test -z "${mmcdev}"; then
		ubi part ubi;
		ubi read ${loadaddr} kernel_${bootside} &&
			source ${loadaddr} || reset;
	elif test -e mmc ${mmcdev}:${bootvol} kernel.itb; then
		load mmc ${mmcdev}:${bootvol} ${loadaddr} kernel.itb &&
			source ${loadaddr} || reset;
	elif test -e mmc ${mmcdev}:${bootvol} fitImage; then
		load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImageVerity.bin &&
			source ${loadaddr} || reset;
		load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImage || reset;
	else
		echo "No kernel found on ${boot_src} partition ${bootvol}!";
		echo "Please check your SD card or eMMC";
		reset;
	fi
#endif
loadregdomain=
	test -z "${RegDomain}" ||
		setenv bootargs ${bootargs} brcmfmac.regdomain=${RegDomain}
RegDomain=US

verify=yes
version=UBOOTRELEASE
