autoload=no
autostart=no
bootcmd=run loadimage && source ${loadaddr} && bootm ${loadaddr}${conf}; reset
bootside=a
cdc_connect_timeout=15
choose_boot=echo
conf=
loadimage=
	run choose_boot;
	if test ${bootside} = b; then
		setenv bootvol 4;
	else
		setenv bootvol 1;
		setenv bootside a;
	fi;
	if test ${boot_src} = sd; then
		setenv rootvol 5;
	else
		setexpr rootvol ${bootvol} + 1;
	fi;
	load mmc ${mmcdev}:${bootvol} ${loadaddr} kernel.itb
verify=yes
version=UBOOTRELEASE
