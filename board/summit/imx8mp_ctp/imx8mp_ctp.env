autoload=no
autostart=no
bootcmd=run loadimage; bootm ${loadaddr}${conf} || bootm ${loadaddr}; reset
bootside=a
cdc_connect_timeout=15
env_fdt_path=/config/environment
loadimage=
	test -z "${choose_boot}" || run choose_boot;
	if test ${bootside} = b; then
		setenv bootvol 4;
	else
		setenv bootvol 1;
		setenv bootside a;
	fi;
	if test ${boot_src} = sd; then
		setenv rootvol 5;
	else
		setexpr rootvol ${bootvol} + 1;
	fi;
	if test -e mmc ${mmcdev}:${bootvol} kernel.itb; then
		load mmc ${mmcdev}:${bootvol} ${loadaddr} kernel.itb &&
			source ${loadaddr} || reset;
	else
		load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImageVerity.bin &&
			source ${loadaddr} || reset;
		load mmc ${mmcdev}:${bootvol} ${loadaddr} fitImage || reset;
	fi
verify=yes
version=UBOOTRELEASE
