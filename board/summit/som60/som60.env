autoload=no
autostart=no
bootcmd=run loadimage && source ${loadaddr}:script && bootm ${loadaddr}${conf}; reset
bootside=a
cdc_connect_timeout=15
env_fdt_path=/config/environment
#ifdef CONFIG_SD_BOOT
loadimage=load mmc 0 ${loadaddr} kernel.itb
#else
#if CONFIG_SYS_GPIO_SIDE_SELECT > -1
rescueside=off
gpio_boot=
	test -n "${bootside}" || setenv bootside a;
	if gpio input CONFIG_SYS_GPIO_SIDE_SELECT; then
		echo "Rescue mode enabled";
		if test "${bootside}" = a; then
			setenv bootside b;
			setenv rescueside b;
		else
			setenv bootside a;
			setenv rescueside a;
		fi;
		echo "Flipped bootside to ${bootside}";
		saveenv;
	else
		if test "${rescueside}" = "${bootside}"; then
			echo "Booting in rescue mode";
		else
			echo "Booting in operational mode";
			if test "${rescueside}" != off; then
				setenv rescueside off;
				saveenv;
			fi;
		fi;
	fi
#endif
loadimage=
#if CONFIG_SYS_GPIO_SIDE_SELECT > -1
	run gpio_boot;
#endif
	test -z "${choose_boot}" || run choose_boot;
	if test ${bootside} = b; then
		setenv bootvol 4;
	else
		setenv bootvol 1;
		setenv bootside a;
	fi;
	ubi part ubi;
	ubi read ${loadaddr} kernel_${bootside}
#endif
verify=yes
version=UBOOTRELEASE
