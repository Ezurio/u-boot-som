#include <generated/version_autogenerated.h>

autoload=no
autostart=no
bootcmd=run loadimage && source ${loadaddr} && bootm ${loadaddr} || reset
bootside=a
cdc_connect_timeout=15
#ifdef CONFIG_SD_BOOT
loadimage=load mmc 0 ${loadaddr} kernel.itb
#else
loadimage=
	if test ${bootside} = b; then
		setenv bootvol 4;
	else
		setenv bootvol 1;
		setenv bootside a;
	fi;
	ubi part ubi;
	ubi read ${loadaddr} kernel_${bootside}
#endif
verify=yes
version=PLAIN_VERSION
